{% if include.id %}
  {% assign feature_row = page[include.id] %}
{% else %}
  {% assign feature_row = page.feature_row %}
{% endif %}

<div class="feature__wrapper" style="margin-top:2em;border-bottom:0px;border-bottom:1px solid #51555d;padding-top:2em;">

  {% for f in feature_row %}
    <div class="feature__item{% if include.type %}--{{ include.type }}{% endif %}">
      <div class="archive__item">
        {% if f.image_path %}
          <div class="archive__item-teaser">
            <img src="{{ f.image_path | relative_url }}"
                 alt="{% if f.alt %}{{ f.alt }}{% endif %}">
            {% if f.image_caption %}
              <span class="archive__item-caption">{{ f.image_caption | markdownify | remove: "<p>" | remove: "</p>" }}</span>
            {% endif %}
          </div>
        {% endif %}
		
		{% if f.icon %}
		  {% assign cycle_index = forloop.index0 | modulo: 2 %}
		  {% if cycle_index == 0 %}
		    {% assign hex_color = "#9aceeb" %}
		    {% assign hex_shadow = "rgba(154, 206, 235, 0.3)" %}
		    {% assign orbit_color = "rgba(154, 206, 235, 0.2)" %}
		    {% assign animation_class = "pulse-glow" %}
		  {% else %}
		    {% assign hex_color = "#ff6b6b" %}
		    {% assign hex_shadow = "rgba(255, 107, 107, 0.3)" %}
		    {% assign orbit_color = "rgba(255, 107, 107, 0.2)" %}
		    {% assign animation_class = "pulse-glow-red" %}
		  {% endif %}
		  <div style="text-align:center; margin: 2rem auto 1.5rem; position: relative;">
		    <span class="fa-stack fa-4x" style="display: inline-block; position: relative;">
              <i class="fas fa-hexagon fa-stack-2x text-primary" style="color:{{ hex_color }}; filter: drop-shadow(0 4px 8px {{ hex_shadow }}); animation: {{ animation_class }} 3s ease-in-out infinite;"></i>
              <i class="{{ f.icon | default: "fa-solid fa-globe" }} fa-stack-1x fa-inverse" style="color: #fff; font-size: 1.2em;"></i>
            </span>
            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; height: 120px; border: 2px solid {{ orbit_color }}; border-radius: 50%; animation: spin-slow 20s linear infinite; pointer-events: none;"></div>
          </div>
        {% endif %}

        <div class="archive__item-body">
          {% if f.title %}
            <h2 class="archive__item-title" style="text-align:center;">{{ f.title }}</h2>
          {% endif %}

          {% if f.excerpt %}
            <div class="archive__item-excerpt" style="text-align:justify;">
              {{ f.excerpt | markdownify }}
            </div>
          {% endif %}

          {% if f.url %}
            <p><a href="{{ f.url | relative_url }}" class="btn {{ f.btn_class }}">{{ f.btn_label | default: site.data.ui-text[site.locale].more_label | default: "Learn More" }}</a></p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}

</div>
